# ─────────────────────────────────────────────
# AuraLearn — Environment Variables
# Copy this to .env and fill in your values
# ─────────────────────────────────────────────

# Required: Google Gemini API Key (for AI roadmap generation)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Server Port (defaults to 4000)
PORT=4000

# App URL (used for self-referential links and OTP email links)
APP_URL="http://localhost:4000"

# ─────────────────────────────────────────────
# SMTP Email Configuration (for OTP delivery)
# ─────────────────────────────────────────────
# If SMTP is not configured, OTPs are printed to the server console (dev mode).
#
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your.email@gmail.com
#   SMTP_PASS=your-gmail-app-password   (App Password, not account password)
#   SMTP_FROM=your.email@gmail.com
#
# To create a Gmail App Password:
#   Google Account → Security → 2-Step Verification → App Passwords
# ─────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_gmail_app_password"
SMTP_FROM="AuraLearn <your_email@gmail.com>"
